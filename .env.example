# Skips the Bloxity SDK (sdk.bloxity.io) and avatar CDN (static.bloxity.io) so local dev never depends on them.
VITE_DEV_MODE=false

# Dev-only starting stats (dev server / VITE_DEV_MODE / build:dev; ignored in prod). Leave blank for the normal fresh start.
VITE_DEV_HAIR=
VITE_DEV_LEVEL=
VITE_DEV_WINS=
VITE_DEV_REBIRTHS=
VITE_DEV_PRESTIGE=
# Comma list of hair style keys (e.g. blueberry,slime) and salon items (cut:braid, charm:lantern, aura:fire, trail:ocean); 'all' owns every hair style and salon item. Treadmills unlock with VITE_DEV_REBIRTHS.
VITE_DEV_OWNED=
# Hair style key to start equipped, e.g. slime
VITE_DEV_EQUIPPED=

# Hair-escape-backend websocket URLs. Dev defaults to ws://localhost:2567 when unset; leave both blank on Bloxity,
# where the SDK resolves the channel's server. With no server the game just plays offline.
VITE_SERVER_URL_DEV=
VITE_SERVER_URL_MAIN=
